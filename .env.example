PORT=4000
CLIENT_URL=http://localhost:5173

# Use your Stripe secret key here. Never put this in React.
STRIPE_SECRET_KEY=sk_test_replace_me

# Stripe Price IDs — create these at dashboard.stripe.com → Product catalog
# Pro Coach plan ($6.99/mo recurring)
STRIPE_PRICE_ID=price_replace_me
STRIPE_PRO_PRICE_ID=price_replace_me
# Organization plan ($39/mo recurring)
STRIPE_ORG_PRICE_ID=price_replace_me

# Get this from Stripe after creating a webhook endpoint or running Stripe CLI listen.
# It usually starts with whsec_.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Create this from Firebase Project Settings > Service accounts.
# Keep the JSON file private and never commit it.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Or paste the full JSON inline (required for Render/Railway deployments):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# VAPID keys for Web Push notifications — generate once with:
#   node -e "const w=require('web-push');console.log(JSON.stringify(w.generateVAPIDKeys()))"
VAPID_PUBLIC_KEY=replace_me
VAPID_PRIVATE_KEY=replace_me
VAPID_EMAIL=mailto:admin@yourdomain.com

# Frontend URL (used for Stripe redirect and CORS)
CLIENT_URL=http://localhost:5173
